# Runtime: Neon pooled URL (hostname contains -pooler)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Migration only: Neon direct URL (hostname does not contain -pooler)
DATABASE_URL_MIGRATIONS=postgresql+psycopg://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

APP_ENV=development
JWT_SECRET_KEY=replace-with-a-64-character-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Reserved for later phases. Never put these in Flutter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
